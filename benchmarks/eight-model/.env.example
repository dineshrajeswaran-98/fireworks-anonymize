# Serverless comparison researched 2026-11-02; see pipeline/BENCHMARK_PLAN.md.
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
# Optional comma-separated model IDs for running a comparison in one command.
FIREWORKS_MODELS=accounts/fireworks/models/gpt-oss-120b,accounts/fireworks/models/deepseek-v4p1-flash-1017,accounts/fireworks/models/glm-5p3-flash
FIREWORKS_MAX_TOKENS=2048
FIREWORKS_TIMEOUT=30
# Leave blank to omit temperature if a model does not support it.
FIREWORKS_TEMPERATURE=0
# Document app: contextual extraction also runs on Fireworks (on/off).
FIREWORKS_CONTEXT_CHECK=on
# Reduced reasoning for extraction (GPT-OSS/GLM low; DeepSeek off).
FIREWORKS_REASONING_PROFILE=extraction
# json_schema enforces output shape; json_object only enforces valid JSON.
FIREWORKS_OUTPUT_MODE=json_schema
# Optional Claude baseline through Fireworks Nexus; not in default runs.
# OpenAI uses the direct adapter and OPENAI_API_KEY below, never Nexus.
ANTHROPIC_API_KEY=
# Direct OpenAI credential; never forwarded to Fireworks.
OPENAI_API_KEY=

# Direct OpenAI Responses API (not routed through Fireworks).
OPENAI_MODEL=gpt-6-luna
OPENAI_MODELS=
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=30
OPENAI_REASONING_EFFORT=low
OPENAI_TEMPERATURE=
